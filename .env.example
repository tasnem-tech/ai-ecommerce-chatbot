# Copy this file to .env.local and fill in your values

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/threadbot
# OR use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/threadbot

# JWT secret for auth tokens (generate a random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# NextAuth secret
NEXTAUTH_SECRET=your-nextauth-secret-change-this
NEXTAUTH_URL=http://localhost:3000

# LLM API — Option A: OpenAI
OPENAI_API_KEY=sk-...

# LLM API — Option B: Google Gemini (uncomment to use)
# GEMINI_API_KEY=your-gemini-key

# Which LLM provider to use: "openai" | "gemini"
LLM_PROVIDER=openai
